<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvNoteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Редагування нотатки"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="16dp" />

    <!-- Поле для тексту нотатки -->
    <EditText
        android:id="@+id/etNoteContent"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:hint="Введіть текст нотатки..."
        android:textSize="14sp"
        android:gravity="top|start"
        android:padding="12dp"
        android:textColor="#212121"
        android:textColorHint="#999999"
        android:background="@drawable/edit_text_background"
        android:layout_marginBottom="16dp" />

    <!-- Секція дат -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Період нотатки"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#424242"
        android:layout_marginBottom="8dp" />

    <!-- Color Picker -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnColor1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:text=""
            app:cornerRadius="20dp"
            app:backgroundTint="#FF5722"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnColor2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:text=""
            app:cornerRadius="20dp"
            app:backgroundTint="#1E88E5"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnColor3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:text=""
            app:cornerRadius="20dp"
            app:backgroundTint="#43A047"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnColor4"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:text=""
            app:cornerRadius="20dp"
            app:backgroundTint="#FFB300"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnColor5"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:text=""
            app:cornerRadius="20dp"
            app:backgroundTint="#AB47BC"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnColorCustom"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="+"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            app:cornerRadius="20dp"
            app:backgroundTint="#9E9E9E"
            app:strokeWidth="0dp" />
    </LinearLayout>

    <!-- Start Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Початок:"
            android:textSize="12sp"
            android:textColor="#757575" />

        <Button
            android:id="@+id/btnStartDate"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="2"
            android:text="Виберіть дату"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- End Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Кінець:"
            android:textSize="12sp"
            android:textColor="#757575" />

        <Button
            android:id="@+id/btnEndDate"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="2"
            android:text="Виберіть дату"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Кнопки дій -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnDeleteNote"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Видалити"
            android:textColor="#F44336"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnCancelNote"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Скасувати"
            android:textColor="#757575" />

        <Button
            android:id="@+id/btnSaveNote"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Зберегти"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50" />
    </LinearLayout>

</LinearLayout>
